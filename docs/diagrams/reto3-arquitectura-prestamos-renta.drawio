        </mxCell>
        <mxCell id="e6" value="6. update PROCESSING" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=0;exitY=0.3;entryX=1;entryY=0.4;" edge="1" parent="1b" source="n_worker" target="n_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="7. invoca (intento único)&#xa;c/ idempotencyKey" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1b" source="n_worker" target="n_cb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="8. forward si&#xa;circuito cerrado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=1;exitY=0.3;entryX=0;entryY=0.4;" edge="1" parent="1b" source="n_cb" target="n_proxy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="9. forward" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1b" source="n_proxy" target="n_vmware">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="10. resultado real&#xa;(puede tardar)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;dashed=1;strokeColor=#999999;fontColor=#999999;exitX=0.7;exitY=0;entryX=0.7;entryY=1;" edge="1" parent="1b" source="n_vmware" target="n_proxy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="11. 200 OK  ó  502&#xa;(ambiguo: timeout/lentitud)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;dashed=1;strokeColor=#d79b00;fontColor=#8a5a00;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1b" source="n_proxy" target="n_cb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="12. 200→SUCCESS&#xa;502→EN_VERIFICACION" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;dashed=1;strokeColor=#d79b00;fontColor=#8a5a00;exitX=0.3;exitY=1;entryX=0.3;entryY=1;" edge="1" parent="1b" source="n_cb" target="n_db">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1080" y="1060" />
              <mxPoint x="470" y="1060" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e13" value="13. cada N min, revisa&#xa;EN_VERIFICACION" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#d79b00;fontColor=#8a5a00;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1b" source="n_reconciler" target="n_status_query">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="14. consulta estado real&#xa;(status API / batch)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#d79b00;fontColor=#8a5a00;exitX=1;exitY=0.2;entryX=0;entryY=0.8;" edge="1" parent="1b" source="n_status_query" target="n_proxy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" value="15. confirmado ejecutado&#xa;/ no ejecutado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;dashed=1;strokeColor=#999999;fontColor=#999999;exitX=0.85;exitY=1;entryX=1;entryY=0.4;" edge="1" parent="1b" source="n_proxy" target="n_status_query">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" value="16. confirmado→SUCCESS&#xa;no ejecutado→FAILED_RETRYABLE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;dashed=1;strokeColor=#d79b00;fontColor=#8a5a00;exitX=0;exitY=0.3;entryX=0.5;entryY=1;" edge="1" parent="1b" source="n_reconciler" target="n_db">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="630" y="705" />
