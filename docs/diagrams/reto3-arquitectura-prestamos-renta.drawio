        <mxCell id="e18" value="18. tras N reconciliaciones&#xa;sin confirmar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1b" source="n_reconciler" target="n_dlq">
