        <mxCell id="n_legend" value="Cómo se cubren los criterios de evaluación:&lt;br&gt;• &lt;b&gt;Escalabilidad&lt;/b&gt;: cola + workers horizontales, se escalan según profundidad de cola&lt;br&gt;• &lt;b&gt;Resiliencia y reintentos&lt;/b&gt;: circuit breaker + reconciliación contra la fuente real (nunca retry ciego) + DLQ&lt;br&gt;• &lt;b&gt;Control de concurrencia&lt;/b&gt;: idempotency key + índice único (polizaId + estado activo) en BD&lt;br&gt;• &lt;b&gt;Seguridad&lt;/b&gt;: JWT/OAuth en Zona Segura, red privada/mTLS hacia INARI, secretos en Vault&lt;br&gt;• &lt;b&gt;Costo&lt;/b&gt;: cola managed de capa gratuita, no se reescribe INARI/admwr — solo se le exige propagar el requestId&lt;br&gt;&lt;br&gt;Colores de flecha: negro = flujo principal · naranja = ambiguo/reconciliación · gris punteado = retorno/observabilidad · rojo = falla/alerta · morado = secretos" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=12;spacing=10;" vertex="1" parent="1b">
          <mxGeometry x="350" y="1090" width="1290" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
