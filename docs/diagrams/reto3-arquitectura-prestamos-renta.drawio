          </mxGeometry>
        </mxCell>
        <mxCell id="e17" value="17. si no ejecutado,&#xa;re-publica (retry seguro)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#2d6a2d;fontColor=#2d6a2d;exitX=1;exitY=0.1;entryX=1;entryY=0.9;" edge="1" parent="1b" source="n_reconciler" target="n_queue">
          <mxGeometry relative="1" as="geometry">
