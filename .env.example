# Copiar a .env antes de `docker compose up`. Estos valores son solo para demo local --
# nunca usar VAULT_ROOT_TOKEN/JWT_SECRET de ejemplo en nada que no sea tu máquina.
VAULT_ROOT_TOKEN=root-token-local-dev-only
JWT_SECRET=CAMBIAR-este-valor-antes-de-cualquier-uso-real-min-32-bytes
POSTGRES_PASSWORD=postgres

# Puertos de host -- deliberadamente fuera del rango convencional (5432/8200/5000/3000/8080/5173)
# para minimizar choques con otros servicios/contenedores ya corriendo en tu máquina. Cambiar si
# alguno igual llegara a estar ocupado.
HOST_PORT_POSTGRES=45432
HOST_PORT_VAULT=48200
HOST_PORT_API_AUTH=45100
HOST_PORT_API_ENDOSOS=43101
HOST_PORT_API_RUTAS=48180
HOST_PORT_WEB=45273
